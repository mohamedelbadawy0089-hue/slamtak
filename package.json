{
  "name": "slamtak",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node start.js",
    "build": "tsc",
    "start": "node start.js",
    "deploy:prod": "wrangler pages deploy ./public --project-name slamtak --branch main --commit-dirty=true",
    "check:security": "node scripts/check-security-invariants.mjs",
    "check:secrets": "node scripts/check-no-tracked-secrets.mjs",
    "check:docs-ar": "node scripts/check-architecture-ar-docs.mjs",
    "check:docs-actions": "node scripts/check-doc-actions.mjs",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "check:supabase": "node scripts/supabase-health.mjs",
    "test:auth": "node --test scripts/test-auth-session.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "pg": "^8.23.1",
    "wrangler": "^3.0.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.0.0",
    "@babel/parser": "^7.0.0",
    "@babel/traverse": "^7.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.0.0"
  }
}
